
# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co

# PostgreSQL
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# LangSmith observability (optional, off by default)
# Create a key at https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=healthgpt
# Tag traces so production and local runs can be filtered apart
APP_ENV=development
# Privacy: upload only structure, timing and token counts (recommended for real users)
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
